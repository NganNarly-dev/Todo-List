<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".OnBoardFinalActivity">
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_on_board"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="240dp"
        />
    <Button
        android:id="@+id/bt_sign_in"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/sign_in"
        android:textColor="@color/white"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/bt_shadow"
        app:backgroundTint="@null"
        />
    <Button
        android:id="@+id/bt_sign_up"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/bt_sign_in"
        app:layout_constraintStart_toStartOf="@+id/bt_sign_in"
        app:layout_constraintEnd_toEndOf="@+id/bt_sign_in"
        android:text="@string/sign_up"
        android:textColor="@color/purple"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_bt_sign_up"
        app:backgroundTint="@null"
        />
    <View
        android:id="@+id/vw_today_task"
        android:layout_width="320dp"
        android:layout_height="250dp"
        android:background="@drawable/today_task"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bt_sign_in"
        android:layout_marginBottom="250dp"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        />
    <View
        android:id="@+id/vw_pic_1"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/pic_1"
        app:layout_constraintStart_toStartOf="@id/vw_today_task"
        app:layout_constraintBottom_toBottomOf="@id/vw_today_task"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        />
    <View
        android:id="@+id/vw_pic_2"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/pic_2"
        app:layout_constraintStart_toStartOf="@id/vw_today_task"
        app:layout_constraintBottom_toBottomOf="@id/vw_today_task"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="26dp"
        />
    <View
        android:id="@+id/vw_pic_3"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/pic_3"
        app:layout_constraintStart_toStartOf="@id/vw_today_task"
        app:layout_constraintBottom_toBottomOf="@id/vw_today_task"
        android:layout_marginStart="58dp"
        android:layout_marginBottom="30dp"
        />
    <View
        android:id="@+id/vw_working_period"
        android:layout_width="320dp"
        android:layout_height="250dp"
        android:background="@drawable/working_period"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bt_sign_in"
        android:layout_marginBottom="30dp"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="@font/inter"
        app:layout_constraintTop_toBottomOf="@id/vw_working_period"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="28dp"
        />
    <TextView
        android:id="@+id/tv_title_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_1"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:fontFamily="@font/inter"
        android:textStyle="normal"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        />


</androidx.constraintlayout.widget.ConstraintLayout>